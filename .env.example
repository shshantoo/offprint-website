# ==============================================================================
# OFFPRINT (অফপ্রিন্ট) — Environment Variables Specification
# ==============================================================================
# Use this template to configure environment variables in your Vercel Dashboard
# under Settings -> Environment Variables (Production, Preview, Development),
# or copy to .env.local for local development.
#
# IMPORTANT: Never commit actual secret keys or .env.local files to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Required)
# ------------------------------------------------------------------------------
# Your Supabase Project REST URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Client API Key (New publishable key or legacy anon key)
# Safe to expose in client browsers; protected by Supabase Row-Level Security (RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Secret Key (Server-Only Secret)
# Used exclusively by trusted server-side route handlers for privileged operations.
# NEVER expose this key in client-side code or browser bundles.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Application Canonical URL & Timezone
# ------------------------------------------------------------------------------
# The canonical production or preview URL of the deployed application.
# Used for constructing absolute URLs in emails, Google OAuth callbacks, and client portal links.
# On Vercel, if omitted, the app automatically falls back to VERCEL_PROJECT_PRODUCTION_URL
# or VERCEL_URL. For custom domains, explicitly specify here:
NEXT_PUBLIC_SITE_URL=https://offprint.agency
NEXT_PUBLIC_APP_URL=https://offprint.agency

# Studio default timezone for appointment bookings and calendar calculations
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Dhaka

# ------------------------------------------------------------------------------
# 3. Server-Side Admin Authorization (Optional / Fallback)
# ------------------------------------------------------------------------------
# Primary admin authorization is verified against public.profiles (role = 'admin').
# Optionally specify comma-separated administrator emails for server-side verification:
ADMIN_EMAILS=admin@offprint.agency

# ------------------------------------------------------------------------------
# 4. Google Cloud OAuth 2.0 & Integrations (Google Calendar + Gmail)
# ------------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs:
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google OAuth Authorized Redirect URI. Must match the URI registered in Google Cloud Console:
# For production: https://offprint.agency/api/admin/integrations/google/callback
# For local dev:  http://localhost:3000/api/admin/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=https://offprint.agency/api/admin/integrations/google/callback
GOOGLE_REDIRECT_URI=https://offprint.agency/api/admin/integrations/google/callback

# Target Google Calendar ID (e.g. "primary" or a dedicated calendar email address)
GOOGLE_CALENDAR_ID=primary

# Gmail sender email address used for sending branded booking notifications
GOOGLE_SENDER_EMAIL=inquiry@offprint.agency

# 32-byte hexadecimal key (64 hex characters) used for AES-256-GCM token encryption at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. Public Agency Branding Metadata
# ------------------------------------------------------------------------------
NEXT_PUBLIC_AGENCY_NAME="OFFPRINT (অফপ্রিন্ট)"
NEXT_PUBLIC_AGENCY_PHONE="+880 1700-000000"
NEXT_PUBLIC_AGENCY_EMAIL="inquiry@offprint.agency"
NEXT_PUBLIC_AGENCY_LOCATION="Dhaka, Bangladesh"
